  },
  "homepage": "https://github.com/sarimmohib/deepseek-bridge",
  "bugs": {
    "url": "https://github.com/sarimmohib/deepseek-bridge/issues"
  },
  "keywords": [
    "deepseek",
    "openai",
    "openai-api",
    "chrome-extension",
    "bridge",
    "llm",
    "zcode",
    "direct"
  ],
  "bin": {
    "deepseek": "./bin/deepseek.js",
    "deepseek-bridge": "./bin/ds-bridge.js",
    "deepseek-chat": "./bin/ds-chat.js",
    "ds": "./bin/deepseek.js",
    "ds-bridge": "./bin/ds-bridge.js",
    "ds-chat": "./bin/ds-chat.js"
  },
  "scripts": {
    "start": "node bin/ds-bridge.js",
